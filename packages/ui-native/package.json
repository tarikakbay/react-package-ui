    "react-native-safe-area-context": ">=5",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "i18next": "^26.7.1",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.4",
    "react-native-safe-area-context": "~5.10.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "zod": "^4.6.7"
