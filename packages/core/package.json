{
  "name": "@cx/core",
  "version": "0.1.0",
  "description": "Cx: platformdan bağımsız tipler, form şeması, i18n ve tema token'ları",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2"
  },
  "peerDependencies": {
    "i18next": ">=26",
    "react": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": ">=17",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "i18next": "^26.7.1",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
